#ifndef __ANIMATIONCURVES_ISPH__
#define __ANIMATIONCURVES_ISPH__

struct TArrayFloats
{
	float* DataPtr;
	int32 ArrayNum;
};

// Must match TBitArray in BitArray.h
struct BitArray
{
	uint32* Data;
	int NumBits;
	int MaxBits;
};

// Must match FBlendedCurve in AnimCurveTypes.h
struct FBlendedCurve
{
	struct TArrayFloats CurveWeights;
	struct BitArray ValidCurveWeights;
	void* UIDToArrayIndexLUT;
	unsigned int16 NumValidCurveCount;
	bool bInitialized;
};

struct TArrayBlendedCurves
{
	struct FBlendedCurve* DataPtr;
	int32 ArrayNum;
};

#endif
